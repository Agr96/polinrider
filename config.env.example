# Copy to config.env (chmod 0600, gitignored). Every key below is allowlisted;
# unknown keys are rejected with exit code 2. No `source`, no command execution.

IOC_FILE=./iocs.txt
HOSTS_FILE=/etc/hosts
BACKUP_DIR=
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/polinrider
ALERT_FILE=
SCAN_ROOTS_FILE=
FIREWALL_BACKEND=auto
REMOTE_INTERVAL=300
LOCAL_INTERVAL=120
SCAN_BRANCHES=1
SHOW_MAP=1
UI_BACKEND=auto
LOG_FORMAT=text
NO_COLOR=0

# Secrets — never printed by `config show` or --verbose.
CANARY_NTFY_TOPIC=
CANARY_DISCORD_URL=
CANARY_SLACK_URL=
CANARY_NATIVE=0

# Optional overrides (space-separated).
CANARY_REPOS=
CANARY_REPO_FILE=
CANARY_TRUSTED_ACTORS=
