#!/usr/bin/env bash
set -euo pipefail
# Test double: `gh auth status` succeeds, `gh api` emits a canned payload.
if [[ "${1:-}" == auth ]]; then exit 0; fi
if [[ "${1:-}" == api ]]; then
  if [[ -n "${FAKE_ACTIVITY_FILE:-}" && -f "$FAKE_ACTIVITY_FILE" ]]; then
    cat "$FAKE_ACTIVITY_FILE"
  else
    printf '[]\n'
  fi
  exit 0
fi
exit 0
